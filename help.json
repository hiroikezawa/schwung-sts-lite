{
  "title": "STS Lite",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Four varispeed",
        "samplers: A 30% L,",
        "B 30% R, C 50% L,",
        "D 50% R.",
        "",
        "Each 1/16 step",
        "retriggers all from",
        "the start at that",
        "step's pitch. Plays",
        "while Move plays.",
        "",
        "Header: 1/2 = page",
        "1 of 2 (Main),",
        "2/2 = Scale."
      ]
    },
    {
      "title": "Pads",
      "lines": [
        "Top right: record",
        " red=on, dim=off",
        "Left of it: random",
        " pitch phrase",
        "Row 2 right four:",
        " edit sound A-D",
        "Hold row 2 left,",
        " tap bottom pads:",
        " sample 1-10",
        "Bottom rows: step",
        " triggers on/off"
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "K1-K4: volume of",
        "  A, B, C, D",
        "  (every page)",
        "K8: pitch, one",
        " scale step/detent",
        "K5-K7: unused",
        "",
        "Jog page 2: K5 base",
        " pitch, K6 root,",
        " K7 scale, K8 8/16",
        " steps",
        "Range: 5 octaves"
      ]
    },
    {
      "title": "Motion",
      "lines": [
        "Arm record, play,",
        "then hold K8: its",
        "pitch is written",
        "into each step it",
        "crosses. Release to",
        "stop. Each sound",
        "keeps its own",
        "pattern."
      ]
    },
    {
      "title": "Samples",
      "lines": [
        "UserLibrary/Samples",
        " /STS Lite/left (A)",
        " /right (B)",
        " /ch3 (C) /ch4 (D)",
        " 01.wav to 10.wav",
        "",
        "WAV 16/24/32-bit or",
        "float. First 5 s",
        "only. Loaded when",
        "the module starts."
      ]
    }
  ]
}
